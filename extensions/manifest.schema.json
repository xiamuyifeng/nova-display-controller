{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-display.local/schemas/extension-manifest.json",
  "title": "Nova Display extension manifest",
  "type": "object",
  "required": ["format", "apiVersion", "id", "name", "version", "entry", "capabilities", "permissions"],
  "properties": {
    "format": { "const": "nova-display-extension" },
    "apiVersion": { "enum": [1, 2] },
    "runtime": { "enum": ["quickjs", "provider"] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": { "type": "string", "minLength": 1, "maxLength": 24 },
    "author": { "type": "string", "maxLength": 64 },
    "description": { "type": "string", "maxLength": 240 },
    "entry": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "windows": { "type": "string", "minLength": 1 },
            "linux": { "type": "string", "minLength": 1 },
            "macos": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "files": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "protocol": { "const": "nova-jsonl-v1" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["variables", "renderer", "events"] }
    },
    "variables": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/definition" } },
    "events": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/definition" } },
    "renderer": {
      "type": "object",
      "required": ["label", "settings"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "settings": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/setting" } }
      },
      "additionalProperties": false
    },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "apiVersion": { "const": 1 } } },
      "then": {
        "properties": {
          "runtime": { "enum": ["quickjs"] },
          "entry": { "type": "string" },
          "permissions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "apiVersion": { "const": 2 } } },
      "then": {
        "required": ["runtime", "protocol"],
        "properties": {
          "runtime": { "const": "provider" },
          "entry": { "type": "object" },
          "permissions": { "const": ["native.process"] }
        }
      }
    }
  ],
  "$defs": {
    "definition": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 48 },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "setting": {
      "type": "object",
      "required": ["key", "label", "type", "default"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 48 },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "type": { "enum": ["range", "number", "toggle", "select"] },
        "default": { "type": ["string", "number", "boolean"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": { "label": { "type": "string" }, "value": { "type": "string" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
